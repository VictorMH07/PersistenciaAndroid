<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.example.persistenciaandroid.permission.READ_TAREAS"
        android:protectionLevel="normal" />

    <permission
        android:name="com.example.persistenciaandroid.permission.WRITE_TAREAS"
        android:protectionLevel="normal" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersistenciaAndroid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PersistenciaAndroid"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".data.TareaContentProvider"
            android:authorities="com.example.persistenciaandroid.provider"
            android:exported="true"
            android:readPermission="com.example.persistenciaandroid.permission.READ_TAREAS"
            android:writePermission="com.example.persistenciaandroid.permission.WRITE_TAREAS" />
    </application>

</manifest>